{
    "name": "synth-gui-react",
    "version": "0.1.0",
    "private": true,
    "homepage": "http://xonik.no/synth-gui-react",
    "type": "module",
    "dependencies": {
        "@types/react-slider": "^1.3.5",
        "@types/webmidi": "^2.0.8",
        "@use-it/event-listener": "^0.1.7",
        "classnames": "^2.3.2",
        "deepmerge": "^4.3.1",
        "immer": "^11.1.4",
        "lodash.flow": "^3.5.0",
        "react": "^18.2.0",
        "react-dnd": "^16.0.1",
        "react-dnd-html5-backend": "^16.0.1",
        "react-dom": "^18.2.0",
        "react-keyed-file-browser": "^1.14.0",
        "react-simple-keyboard": "^3.7.110",
        "react-slider": "^2.0.6",
        "react-spring": "^9.7.3",
        "sass": "^1.69.5",
        "styled-components": "^6.1.8",
        "zustand": "^5.0.12"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "type-check": "tsc --noEmit",
        "lint:fix": "biome check --write .",
        "run-ts": "tsx",
        "generateCppFiles": "npm run run-ts utils/cppMidiGenerator/cppMidiConfigGenerator.ts",
        "generateMidiRPCFiles": "npm run run-ts utils/midiRPC/midiRPCGenerator.ts",
        "bomPopulator": "npm run run-ts utils/bomPopulator/bomPopulator.ts",
        "convertToFrequency": "npm run run-ts utils/frequencyChecker/convertToFrequency.ts",
        "calcSoftClip": "npm run run-ts utils/softClipCalculator/calcSoftClip.ts",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.10",
        "@types/lodash": "^4.14.202",
        "@types/node": "^20.10.6",
        "@types/react": "^18.2.45",
        "@types/react-dom": "^18.2.18",
        "@types/styled-components": "^5.1.26",
        "@vitejs/plugin-react": "^4.2.1",
        "gh-pages": "^6.1.1",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "vite": "^5.0.8",
        "vitest": "^4.1.0"
    }
}
